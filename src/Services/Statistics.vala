using Flowtime.Models;

[SingleInstance]
public class Flowtime.Services.Statistics : GLib.Object {
    private Xml.Doc* doc = new Xml.Doc ("1.0");
    private Xml.Node* root_element;

    private string path {
        owned get {
            return Path.build_filename (Environment.get_user_data_dir (), "statistics.xml");
        }
    }

    public Day? today { get; private set; default = null; }

    public List<Day> all_days = new List<Day> ();
    public string productive_day { get; private set; default = ""; }

    public State total = new State ();
    public State month = new State ();
    public State week = new State ();

    public signal void updated ();

    ~Statistics () {
        delete doc;
    }

    private static Statistics? instance = null;
    public Statistics () {
        if (instance == null) {
            instance = this;
        }
    }

    construct {
        root_element = new Xml.Node (null, "statistics");
        doc->set_root_element (root_element);
        Xml.Node* comment = new Xml.Node.comment ("GENERATED BY FLOWORK : DO NOT MODIFY");
        root_element->add_child (comment);

        retrieve_statistics ();
    }

    private void retrieve_statistics () {
        var file = File.new_for_path (path);

        if (!file.query_exists ()) {
            setup_new_statistics_file ();
            save ();
            return;
        }

        delete doc;

        doc = Xml.Parser.parse_file (path);
        if (doc == null) {
            warning ("Statistics file was found, but cannot be parsed. Creating a new one");
            doc = new Xml.Doc ("1.0");
            root_element = new Xml.Node (null, "statistics");
            doc->set_root_element (root_element);
            setup_new_statistics_file ();
            save ();
            return;
        }

        root_element = doc->get_root_element ();
        retrieve_days ();
    }

    private void setup_new_statistics_file () {
        root_element->new_prop ("start", new DateTime.now_utc ().format_iso8601 ());
        today = new Day ();
        root_element->add_child (today.node);
        all_days.append (today);
    }

    private void retrieve_days () {
        assert (root_element->name == "statistics");
        var current_date = new DateTime.now_local ();
        var settings = new Settings ();

        int months_saved = settings.months_saved;
        Day[] overpassed_days = {};

        const TimeSpan WEEK = TimeSpan.DAY * 7;
        const TimeSpan MONTH = TimeSpan.DAY * 30;

        for (Xml.Node* i = root_element->children; i != null; i = i->next) {
            if (i->type == ELEMENT_NODE) {
                var d = new Day.from_xml (XmlUtils.get_content_node (i, "day"));
                TimeSpan ts = current_date.difference (d.date);

                if (ts > MONTH * months_saved) {
                    overpassed_days += d;
                    continue;
                }

                total.worktime += d.worktime;
                total.breaktime += d.breaktime;
                all_days.append (d);

                if (ts > MONTH) {
                    continue;
                }

                month.worktime += d.worktime;
                month.breaktime += d.breaktime;
                if (ts > WEEK) {
                    continue;
                }

                week.worktime += d.worktime;
                week.breaktime += d.breaktime;

                if (same_local_day (d.date, current_date)) {
                    today = d;
                }
            }
        }

        if (today == null) {
            today = new Day ();
            root_element->add_child (today.node);
            all_days.append (today);
        }

        foreach (var day in overpassed_days) {
            day.unlink ();
        }

        get_most_productive_day ();
    }

    public static bool same_local_day (DateTime a, DateTime b) {
        return a.get_year () == b.get_year () && a.get_day_of_year () == b.get_day_of_year ();
    }

    public Day ensure_day_for (DateTime local_dt) {
        if (today != null && same_local_day (today.date, local_dt)) {
            return today;
        }

        foreach (Day d in all_days) {
            if (same_local_day (d.date, local_dt)) {
                if (same_local_day (local_dt, new DateTime.now_local ())) {
                    today = d;
                }
                return d;
            }
        }

        var created = new Day ();
        created.date = local_dt;
        root_element->add_child (created.node);
        all_days.append (created);

        if (same_local_day (local_dt, new DateTime.now_local ())) {
            today = created;
        }
        return created;
    }

    public void add_time_to_mode (TimerMode mode, int time_seconds, DateTime? end_local = null) {
        if (time_seconds <= 0) {
            return;
        }

        var end_dt = end_local ?? new DateTime.now_local ();
        var start_dt = end_dt.add_seconds (-time_seconds);

        if (same_local_day (start_dt, end_dt)) {
            var target_day = ensure_day_for (end_dt);
            apply_seconds_to_day (target_day, mode, time_seconds);
        } else {
            var cursor = start_dt;
            int remaining = time_seconds;
            while (remaining > 0) {
                var next_midnight = new DateTime.local (
                    cursor.get_year (),
                    cursor.get_month (),
                    cursor.get_day_of_month (),
                    0, 0, 0
                ).add_days (1);

                int sec_until_midnight = (int) (next_midnight.difference (cursor) / TimeSpan.SECOND);
                int chunk = int.min (remaining, int.max (1, sec_until_midnight));

                var target_day = ensure_day_for (cursor);
                apply_seconds_to_day (target_day, mode, chunk);

                remaining -= chunk;
                cursor = next_midnight;
            }
            ensure_day_for (end_dt);
        }

        get_most_productive_day ();
        save ();
        updated ();
    }

    private void apply_seconds_to_day (Day day, TimerMode mode, int seconds) {
        switch (mode) {
            case WORK:
                day.worktime += seconds;
                week.worktime += seconds;
                month.worktime += seconds;
                total.worktime += seconds;
                break;

            case BREAK:
                day.breaktime += seconds;
                week.breaktime += seconds;
                month.breaktime += seconds;
                total.breaktime += seconds;
                break;

            default:
                assert_not_reached ();
        }
    }

    public int get_time_from_mode_and_period (TimerMode mode, TimePeriod period) {
        if (mode == WORK) {
            return get_worktime_from_period (period);
        }
        return get_breaktime_from_period (period);
    }

    private int get_worktime_from_period (TimePeriod period) {
        switch (period) {
            case TODAY:
                return today.worktime;
            case WEEK:
                return week.worktime;
            case MONTH:
                return month.worktime;
            case ALL:
                return total.worktime;
            default:
                assert_not_reached ();
        }
    }

    private int get_breaktime_from_period (TimePeriod period) {
        switch (period) {
            case TODAY:
                return today.breaktime;
            case WEEK:
                return week.breaktime;
            case MONTH:
                return month.breaktime;
            case ALL:
                return total.breaktime;
            default:
                assert_not_reached ();
        }
    }

    private void get_most_productive_day () {
        var days_table = new HashTable<string, int?> (string.hash, str_equal);

        foreach (Day day in all_days) {
            if (!(day.day_of_week in days_table)) {
                days_table[day.day_of_week] = day.worktime;
                continue;
            }
            int time = days_table[day.day_of_week] + day.worktime;
            days_table[day.day_of_week] = time;
        }

        int highest = -1;
        foreach (string day_string in days_table.get_keys ()) {
            int count = days_table[day_string];
            if (count >= highest) {
                productive_day = day_string;
                highest = count;
            }
        }
    }

    public void save () {
        var dir = Path.get_dirname (path);
        DirUtils.create_with_parents (dir, 0755);

        string xml_content;
        int len;
        doc->dump_memory_enc (out xml_content, out len, "UTF-8");

        try {
            var file = File.new_for_path (path);
            file.replace_contents (
                xml_content.data,
                null,
                false,
                FileCreateFlags.REPLACE_DESTINATION,
                null
            );
        } catch (Error e) {
            warning ("Failed to atomically save statistics: %s", e.message);
        }
    }
}

public enum Flowtime.Services.TimePeriod {
    TODAY,
    WEEK,
    MONTH,
    ALL;

    public string to_string () {
        switch (this) {
            case TODAY:
                return _("Today");
            case WEEK:
                return _("This Week");
            case MONTH:
                return _("This Month");
            case ALL:
                return _("All Time");
            default:
                assert_not_reached ();
        }
    }
}
